# Not sure what a .gitignore is?
# See: https://git-scm.com/docs/gitignore

# These are directly copied from Jekyll's first-party docs on `.gitignore` files:
# https://jekyllrb.com/tutorials/using-jekyll-with-bundler/#commit-to-source-control

# Ignore the default location of the built site, and caches and metadata generated by Jekyll
_site/
.sass-cache/
.jekyll-cache/
.jekyll-metadata

# Ignore folders generated by Bundler
.bundle/
vendor/

.venv/*

# Ignore nix stuff
.direnv/

# Quarto (caches and transient notebooks in any subproject)
**/.quarto/
**/*.quarto_ipynb

.DS_Store
.Rproj.user
*.Rproj

# Server / runtime logs
*.log

# LaTeX intermediates
*.aux
*.fls
*.fdb_latexmk
*.synctex.gz
*.out

# Editor / transient artifacts
*.bak
*.tmp

# R serialized objects (regenerated by analysis scripts)
*.rds

# Copyrighted reference papers (don't redistribute)
_angristevans/AngristFrandsen2022.pdf
_dube_monopsony/DDML_paper.pdf
