lassocv  mean_weight= 0.280744  rep_1= 0.280744

. di "rf       mean_weight=" %9.6f w_D[1,3] "  rep_1=" %9.6f w_D[1,3]
rf       mean_weight= 0.719256  rep_1= 0.719256

. 
. // Clean up before Part 3
. drop Y_hat_* D_hat_* Y_tilde D_tilde Y_hat_ss D_hat_ss

. 
. 
. // PART 3: Final DML model (11 resamples, median aggregation)
. 
. set seed 42

. 
. local K = 10

. local R = 11

. 
. tempname coef_mat se_mat weights_Y_mat weights_D_mat

. matrix `coef_mat'      = J(`R', 1, .)

. matrix `se_mat'        = J(`R', 1, .)

. matrix `weights_Y_mat' = J(3, `R', .)

. matrix `weights_D_mat' = J(3, `R', .)

. 
. forvalues r = 1/`R' {
  2. 
.     di "Processing resample `r' of `R'..."
  3. 
.     drop fold_id
  4.     gen fold_id = mod(_n - 1, `K') + 1
  5.     gen random_order = runiform()
  6.     sort random_order
  7.     drop random_order
  8. 
.     gen Y_hat_ols   = .
  9.     gen Y_hat_lasso = .
 10.     gen Y_hat_rf    = .
 11. 
.     gen D_hat_ols   = .
 12.     gen D_hat_lasso = .
 13.     gen D_hat_rf    = .
 14. 
.     forvalues k = 1/`K' {
 15. 
.         qui reg `Y_var' `X_vars' if fold_id != `k'
 16.         qui predict Y_hat_ols_temp if fold_id == `k'
 17.         qui replace Y_hat_ols = Y_hat_ols_temp if fold_id == `k'
 18.         drop Y_hat_ols_temp
 19. 
.         qui pystacked `Y_var' `X_vars' if fold_id != `k', ///
>             type(reg) method(lassocv)
 20.         qui predict Y_hat_lasso_temp if fold_id == `k'
 21.         qui replace Y_hat_lasso = Y_hat_lasso_temp if fold_id == `k'
 22.         drop Y_hat_lasso_temp
 23. 
.         qui pystacked `Y_var' `X_vars' if fold_id != `k', ///
>             type(reg) method(rf)
 24.         qui predict Y_hat_rf_temp if fold_id == `k'
 25.         qui replace Y_hat_rf = Y_hat_rf_temp if fold_id == `k'
 26.         drop Y_hat_rf_temp
 27. 
.         qui reg `D_var' `X_vars' if fold_id != `k'
 28.         qui predict D_hat_ols_temp if fold_id == `k'
 29.         qui replace D_hat_ols = D_hat_ols_temp if fold_id == `k'
 30.         drop D_hat_ols_temp
 31. 
.         qui pystacked `D_var' `X_vars' if fold_id != `k', ///
>             type(reg) method(lassocv)
 32.         qui predict D_hat_lasso_temp if fold_id == `k'
 33.         qui replace D_hat_lasso = D_hat_lasso_temp if fold_id == `k'
 34.         drop D_hat_lasso_temp
 35. 
.         qui pystacked `D_var' `X_vars' if fold_id != `k', ///
>             type(reg) method(rf)
 36.         qui predict D_hat_rf_temp if fold_id == `k'
 37.         qui replace D_hat_rf = D_hat_rf_temp if fold_id == `k'
 38.         drop D_hat_rf_temp
 39.     }
 40. 
.     // Short-stacking via nnls2 for this rep
.     nnls2 `Y_var' Y_hat_ols Y_hat_lasso Y_hat_rf
 41.     mat w_Y_`r' = e(b)
 42.     matrix `weights_Y_mat'[1, `r'] = w_Y_`r'[1,1]
 43.     matrix `weights_Y_mat'[2, `r'] = w_Y_`r'[1,2]
 44.     matrix `weights_Y_mat'[3, `r'] = w_Y_`r'[1,3]
 45. 
.     nnls2 `D_var' D_hat_ols D_hat_lasso D_hat_rf
 46.     mat w_D_`r' = e(b)
 47.     matrix `weights_D_mat'[1, `r'] = w_D_`r'[1,1]
 48.     matrix `weights_D_mat'[2, `r'] = w_D_`r'[1,2]
 49.     matrix `weights_D_mat'[3, `r'] = w_D_`r'[1,3]
 50. 
.     matrix score Y_hat_ss = w_Y_`r'
 51.     matrix score D_hat_ss = w_D_`r'
 52. 
.     gen Y_tilde = `Y_var' - Y_hat_ss
 53.     gen D_tilde = `D_var' - D_hat_ss
 54. 
.     qui reg Y_tilde D_tilde, robust
 55. 
.     matrix `coef_mat'[`r', 1] = _b[D_tilde]
 56.     matrix `se_mat'[`r', 1]   = _se[D_tilde]
 57. 
.     drop Y_hat_* D_hat_* Y_tilde D_tilde Y_hat_ss D_hat_ss
 58. }
