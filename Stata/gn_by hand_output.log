. do gn_latest.do 

. // GN full replication in Stata
. // "By-hand" DDML approach
. // =========================
. 
. clear

. set more off

. set seed 42

. 
. version
version 19.5

. which pystacked
/home/smkhitaryan/ado/plus/p/pystacked.ado
*! pystacked v0.7.9
*! last edited: 26oct2025
*! authors: aa/ms
*! pystacked wrapper - calls pystacked1 (default) or pystacked2 (altpython opti
> on)

. which nnls2
/home/smkhitaryan/ado/plus/n/nnls2.ado
*! nnls v1.0.0
*! last edited: 3aug2026
*! authors: aa/ms

. 
. // PART 1: OLS replication
. 
. // Load data
. use "https://dmlguide.github.io/assets/dta/GN2021.dta"

. 
. // Shorten the name of the causal variable of interest to sd_EE
. gen sd_EE = sd_of_gen_mean_temp_anom_EE

. 
. // Replicate results with no controls in Table 1, column (3).
. // HC1 robust SE
. reg A198new sd_EE, robust

Linear regression                               Number of obs     =         75
                                                F(1, 73)          =      13.54
